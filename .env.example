# Variables para desarrollo local (.env) y Render (panel Environment)

# SQL Server (obligatorio en producción)
SQL_SERVER=tu_servidor,1433
SQL_DATABASE=tu_base_de_datos
SQL_USER=tu_usuario
SQL_PASSWORD=tu_contraseña

# Linux / Docker (Render usa msodbcsql18)
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Flask (obligatorio en producción — clave larga y aleatoria)
FLASK_SECRET_KEY=cambie-esta-clave-en-produccion

# WhatsApp - Evolution API v2 (alertas_vencimiento.py)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=tu_api_key
EVOLUTION_INSTANCE=nombre_de_tu_instancia
WHATSAPP_DESTINO=51XXXXXXXXX
EVOLUTION_VERIFY_SSL=true

# Gunicorn (Render puede definirlas en render.yaml)
# PORT=10000
# WEB_CONCURRENCY=1
# GUNICORN_TIMEOUT=120
