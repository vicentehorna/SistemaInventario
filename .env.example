# Copie este archivo como .env y complete los valores para ejecutar en local.

# SQL Server
SQL_SERVER=tu_servidor,1433
SQL_DATABASE=tu_base_de_datos
SQL_USER=tu_usuario
SQL_PASSWORD=tu_contraseña

# Flask
FLASK_SECRET_KEY=cambie-esta-clave-en-produccion

# Opcional (funciones heredadas del portal anterior)
# SERVICE_ACCOUNT_FILE=ruta\al\service-account.json
# RESEND_API_KEY=
